<?xml version="1.0" encoding="utf-8"?>
    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@android:color/black">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/fullscreen_surface"
            android:layout_width="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_height="wrap_content"/>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:id="@+id/menu"
            android:orientation="horizontal"
            android:padding="16dp">


            <LinearLayout
                android:layout_width="wrap_content"
                android:id="@+id/androidMenu"
                android:layout_height="wrap_content">
                <!-- 主页按钮 -->
                <ImageButton
                    android:id="@+id/home"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/home_24px"
                    android:layout_marginEnd="8dp"/>
                <ImageButton
                    android:id="@+id/back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/arrow_back_ios_24px"
                    android:layout_marginEnd="8dp"/>
                <ImageButton
                    android:id="@+id/tv"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/tv_off_24px"
                    android:layout_marginEnd="8dp"/>


                <!-- 退出全屏按钮 -->
            </LinearLayout>
            <ImageButton
                android:id="@+id/volume"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/volume_up_24px"/>
            <ImageButton
                android:id="@+id/btn_shrink"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/fullscreen_exit_24px"/>
            <ImageButton
                android:id="@+id/ptp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/picture_in_picture_24px"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>
    </FrameLayout>
